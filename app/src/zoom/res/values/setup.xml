<resources>
    <string name="app_name">Nextcloud Zoom</string>
    <string name="account_type">nextcloud.zoom</string>
    <string name="authority">org.nextcloud.zoom.provider</string>
    <string name="users_and_groups_search_authority">org.nextcloud.zoom.android.providers.UsersAndGroupsSearchProvider</string>
    <string name="users_and_groups_share_with">org.nextcloud.zoom.android.providers.UsersAndGroupsSearchProvider.action.SHARE_WITH</string>
    <string name="document_provider_authority">org.nextcloud.zoom.documents</string>
    <string name="file_provider_authority">org.nextcloud.zoom.files</string>
    <string name="image_cache_provider_authority">org.nextcloud.zoom.android.providers.imageCache</string>
    <string name="default_display_name_for_root_folder">Nextcloud Zoom</string>
</resources>
